# Copy this file to Railway Variables or a local .env file. Never commit real values.
NODE_ENV=production
PORT=3000

# Railway persistent storage
APP_DATA_DIR=/data
DATABASE_PATH=/data/database.db
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups

# Bosta integration
BOSTA_API_KEY=put_your_bosta_key_here
BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_WEBHOOK_AUTH=change_this_secret

# Free-tier AI form PDF analysis (server-side only)
GEMINI_API_KEY=put_your_gemini_key_here
GEMINI_FORM_MODEL=gemini-3.5-flash-lite

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_SECONDS=180
LOCATION_TRACKING_ENABLED=1

# ===== الربط مع موقع البيع (Craft Zone Store) =====
# نفس المفتاح الموجود على الموقع باسم CZ_INTEGRATION_KEY
STORE_BASE_URL=https://craft-zone-packing-production.up.railway.app
STORE_INTEGRATION_KEY=
# أو استخدم نفس الاسم الموجود على الموقع مباشرة:
CZ_INTEGRATION_KEY=
STORE_SYNC_ENABLED=1
STORE_SYNC_INTERVAL=25
